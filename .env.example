# Copy to .env locally. Never commit real credentials.
APP_NAME=人生冒险之旅
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# Leave blank to preview the shell with a truthful not-configured status.
# Use a dedicated Supabase development database. Percent-encode password characters.
# Example format only: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=
# Explicit migration role connection; direct or session pooler, NOT transaction pooler.
MIGRATION_DATABASE_URL=

# Fernet keys, newest first, comma-separated. Keep outside Git.
AI_ENCRYPTION_KEYS=
# Optional real provider test credentials. Never exported.
AI_TEST_BASE_URL=
AI_TEST_MODEL=
AI_TEST_API_KEY=

# Private cloud images. Server-side only; never expose the service key to browsers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Optional read-only display only. No need to create public keys for this UI.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# Display recognizes this field; Storage continues to use SERVICE_ROLE_KEY above.
SUPABASE_SECRET_KEY=
# Independent backup destination (external drive/NAS). No automatic scheduling.
MEMORY_BACKUP_DIR=
# Separate 32-byte URL-safe base64 encryption key. Keep apart from backup files.
MEMORY_BACKUP_KEY=

# Optional integration database; tests create/delete isolated schemas here.
TEST_DATABASE_URL=
